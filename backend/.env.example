# JAL-RAKSHA AI - Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file with real keys.

# --- AI Provider (pick one) ---
# Groq (recommended — fast inference, free tier available)
GROQ_API_KEY=
# OpenAI
# OPENAI_API_KEY=
# Google Gemini
# GEMINI_API_KEY=
# Anthropic
# ANTHROPIC_API_KEY=

# --- Admin authentication ---
# Required for data-upload and report-status endpoints.
# Generate a random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_KEY=

# --- Backend ---
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Secret Rotation ---
# If a key was ever committed to Git history:
#   1. Revoke the compromised key immediately at the provider's dashboard.
#   2. Generate a new key.
#   3. Paste the new key into this .env file (NOT .env.example).
#   4. Consider using BFG Repo-Cleaner to scrub Git history.
